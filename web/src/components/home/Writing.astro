---
import { getCollection } from 'astro:content';
import { writingTeaser } from '@/data/writing';
import { writingNavItem, isNavItemVisible } from '@/data/home';
import { isPostVisible } from '@/content.config';

const isActive = isNavItemVisible(writingNavItem);

const posts = isActive
	? (await getCollection('blog', isPostVisible))
			.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
			.slice(0, 3)
	: [];
---

{
	isActive && (
		<section id="writing" class="flex min-h-screen flex-col justify-center px-6 py-16">
			<div class="relative z-10 mx-auto max-w-6xl">
				<span class="section-label">{writingTeaser.label}</span>
				<h2 class="section-heading">{writingTeaser.heading}</h2>

				<div class="mt-10 flex flex-col gap-4">
					{posts.length > 0 ? (
						posts.map((post) => (
							<a href={`/writing/${post.id}`} class="card-surface block rounded-2xl p-6">
								<p class="card-meta text-neutral-500 dark:text-neutral-400">
									{post.data.pubDate.toLocaleDateString('en-US', {
										year: 'numeric',
										month: 'long',
										day: 'numeric',
									})}
								</p>
								<p class="card-body mt-1 font-semibold">{post.data.title}</p>
								<p class="card-meta mt-2 text-neutral-500 dark:text-neutral-400">{post.data.description}</p>
							</a>
						))
					) : (
						<p class="card-meta text-neutral-500 dark:text-neutral-400">
							Nothing published yet, first posts are on the way.
						</p>
					)}
				</div>

				<a href="/writing" class="card-meta mt-6 inline-block font-semibold underline-offset-4 hover:underline">
					See all posts →
				</a>
			</div>
		</section>
	)
}
