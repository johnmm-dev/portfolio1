---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { writingTeaser } from '../../data/writing';
import { isPostVisible } from '../../content.config';

const posts = (await getCollection('blog', isPostVisible)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Layout title="Writing — Adnan Sabbir" description={writingTeaser.description}>
	<section class="mx-auto max-w-3xl px-6 py-16">
		<a href="/" class="card-meta font-semibold underline-offset-4 hover:underline">← Back to home</a>

		<span class="section-label mt-6 block">{writingTeaser.label}</span>
		<h1 class="section-heading">{writingTeaser.heading}</h1>

		<div class="mt-10 flex flex-col gap-4">
			{
				posts.length > 0 ? (
					posts.map((post) => (
						<a href={`/writing/${post.id}`} class="card-surface block rounded-2xl p-6">
							<p class="card-meta text-neutral-500 dark:text-neutral-400">
								{post.data.pubDate.toLocaleDateString('en-US', {
									year: 'numeric',
									month: 'long',
									day: 'numeric',
								})}
							</p>
							<p class="card-body mt-1 font-semibold">{post.data.title}</p>
							<p class="card-meta mt-2 text-neutral-500 dark:text-neutral-400">{post.data.description}</p>
						</a>
					))
				) : (
					<p class="card-meta text-neutral-500 dark:text-neutral-400">
						Nothing published yet, first posts are on the way.
					</p>
				)
			}
		</div>
	</section>
</Layout>
