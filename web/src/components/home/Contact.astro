---
import GithubIcon from '@/components/common/icons/GithubIcon.astro';
import LinkedinIcon from '@/components/common/icons/LinkedinIcon.astro';
import CopyIcon from '@/components/common/icons/CopyIcon.astro';
import CheckIcon from '@/components/common/icons/CheckIcon.astro';
import MapPinIcon from '@/components/common/icons/MapPinIcon.astro';
import { contact } from '@/data/contact';
import { socialLinks } from '@/data/social';
---

<section id="contact" class="flex min-h-screen flex-col justify-center px-6 py-16">
	<div
		class="card-surface contact-card relative z-10 mx-auto flex w-full max-w-5xl flex-col overflow-hidden rounded-3xl md:flex-row">
		<div class="contact-glow" aria-hidden="true"></div>
		<div class="contact-grid" aria-hidden="true"></div>

		<div class="relative z-10 flex flex-1 flex-col justify-center p-8 md:p-12">
			<span class="section-label">{contact.label}</span>

			<h2 class="section-heading">{contact.heading}</h2>

			<p class="card-body mt-4 max-w-[36ch] leading-relaxed text-neutral-600 dark:text-neutral-300">
				{contact.subtitle}
			</p>

			<div
				class:list={[
					'card-meta mt-6 inline-flex w-fit items-center gap-2 rounded-full border border-neutral-200 px-3 py-1.5 font-medium text-neutral-600',
					'dark:border-neutral-700 dark:text-neutral-300',
				]}>
				<span class="relative flex h-2 w-2">
					<span
						class:list={[
							'absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-500 opacity-75',
							'motion-reduce:animate-none',
						]}></span>
					<span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
				</span>
				{contact.availability}
			</div>
		</div>

		<div
			class:list={[
				'relative z-10 flex flex-1 flex-col items-start justify-center gap-5 border-t border-neutral-200 p-8',
				'md:border-t-0 md:border-l md:p-12',
				'dark:border-[#49618b52]',
			]}>
			<div
				class:list={[
					'location-panel relative flex w-full items-center gap-4 overflow-hidden rounded-2xl border border-neutral-200 bg-neutral-50/60 p-4',
					'dark:border-[#49618b52] dark:bg-white/[0.03]',
				]}>
				<div class="location-grid" aria-hidden="true"></div>

				<span class="relative z-10 flex h-11 w-11 shrink-0 items-center justify-center">
					<span
						class:list={[
							'absolute h-11 w-11 animate-ping rounded-full bg-neutral-400/20',
							'motion-reduce:animate-none',
							'dark:bg-neutral-300/10',
						]}></span>
					<span class="absolute h-8 w-8 rounded-full border border-neutral-300 dark:border-neutral-600"></span>
					<span
						class:list={[
							'relative flex h-8 w-8 items-center justify-center rounded-full border border-neutral-300 bg-white text-neutral-700',
							'dark:border-neutral-600 dark:bg-neutral-900 dark:text-neutral-200',
						]}>
						<MapPinIcon size={15} />
					</span>
				</span>

				<div class="relative z-10 flex flex-col">
					<span class="card-body font-semibold">{contact.location}</span>
					<span class="card-meta font-mono text-neutral-500 dark:text-neutral-400">{contact.coordinates}</span>
				</div>
			</div>

			<div
				class="flex items-center gap-2 rounded-full border border-neutral-200 py-1.5 pr-1.5 pl-4 dark:border-neutral-700">
				<a
					href={`mailto:${contact.email}`}
					class="font-mono text-sm text-neutral-700 hover:underline sm:text-base dark:text-neutral-200">
					{contact.email}
				</a>
				<button
					id="copy-email-button"
					type="button"
					data-email={contact.email}
					aria-label="Copy email address"
					class:list={[
						'flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-neutral-200 text-neutral-500 transition active:scale-95',
						'focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-900',
						'dark:border-neutral-700 dark:text-neutral-400 dark:focus-visible:outline-white',
					]}>
					<span class="copy-icon"><CopyIcon size={14} /></span>
					<span class="check-icon hidden"><CheckIcon size={14} /></span>
				</button>
				<span id="copy-status" class="sr-only" role="status"></span>
			</div>

			<div class="flex gap-3">
				<a
					href={socialLinks.github.href}
					target="_blank"
					rel="noopener noreferrer"
					aria-label={socialLinks.github.label}
					class:list={[
						'flex h-11 w-11 items-center justify-center rounded-full border border-neutral-200 text-neutral-600 transition hover:border-neutral-400 active:scale-95',
						'focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-900',
						'dark:border-neutral-700 dark:text-neutral-300 dark:focus-visible:outline-white',
					]}>
					<GithubIcon />
				</a>
				<a
					href={socialLinks.linkedin.href}
					target="_blank"
					rel="noopener noreferrer"
					aria-label={socialLinks.linkedin.label}
					class:list={[
						'flex h-11 w-11 items-center justify-center rounded-full border border-neutral-200 text-neutral-600 transition hover:border-neutral-400 active:scale-95',
						'focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-900',
						'dark:border-neutral-700 dark:text-neutral-300 dark:focus-visible:outline-white',
					]}>
					<LinkedinIcon />
				</a>
			</div>
		</div>
	</div>
</section>

<style>
	/* Faint circuit-board dot grid and a soft accent glow behind the card —
	   a quiet nod to the backend/robotics theme, not meant to compete with
	   the text. `color: currentColor` lets the dot grid pick up a light/dark
	   tint via the `color` overrides below. */
	.contact-card {
		isolation: isolate;
	}

	.contact-glow {
		position: absolute;
		inset: -20% -10% auto auto;
		z-index: 0;
		width: 60%;
		height: 140%;
		background: radial-gradient(circle, #7c3aed26, transparent 70%);
		filter: blur(60px);
		pointer-events: none;
	}

	.contact-grid {
		position: absolute;
		inset: 0;
		z-index: 0;
		background-image: radial-gradient(currentColor 1px, transparent 1px);
		background-size: 22px 22px;
		color: #0000000a;
		pointer-events: none;
	}

	:global(.dark) .contact-glow {
		background: radial-gradient(circle, #22d3ee1f, transparent 70%);
	}

	:global(.dark) .contact-grid {
		color: #ffffff0f;
	}

	/* Same dot-grid technique as .contact-grid, tighter and confined to the
	   location panel so it reads as a map/coordinate surface rather than a
	   repeat of the card-wide background. */
	.location-panel {
		isolation: isolate;
	}

	.location-grid {
		position: absolute;
		inset: 0;
		z-index: 0;
		background-image: radial-gradient(currentColor 1px, transparent 1px);
		background-size: 12px 12px;
		color: #00000014;
		pointer-events: none;
	}

	:global(.dark) .location-grid {
		color: #ffffff14;
	}
</style>

<script>
	const button = document.getElementById('copy-email-button');
	const status = document.getElementById('copy-status');
	const copyIcon = button?.querySelector('.copy-icon');
	const checkIcon = button?.querySelector('.check-icon');
	let resetTimeout: ReturnType<typeof setTimeout> | undefined;

	button?.addEventListener('click', async () => {
		const email = button.dataset.email;
		if (!email) return;

		try {
			await navigator.clipboard.writeText(email);
		} catch {
			return;
		}

		copyIcon?.classList.add('hidden');
		checkIcon?.classList.remove('hidden');
		button.setAttribute('aria-label', 'Email address copied');
		if (status) status.textContent = 'Email address copied to clipboard';

		clearTimeout(resetTimeout);
		resetTimeout = setTimeout(() => {
			copyIcon?.classList.remove('hidden');
			checkIcon?.classList.add('hidden');
			button.setAttribute('aria-label', 'Copy email address');
			if (status) status.textContent = '';
		}, 2000);
	});
</script>
