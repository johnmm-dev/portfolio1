---
import YoutubeIcon from '../common/icons/YoutubeIcon.astro';
import { selectedWorkTeaser } from '../../data/selected-work';

const icons = {
	youtube: YoutubeIcon,
};

const activeItems = selectedWorkTeaser.items.filter((item) => item.active).sort((a, b) => a.order - b.order);
---

<section id="projects" class="flex min-h-screen flex-col justify-center px-6 py-16">
	<div class="relative z-10 mx-auto max-w-6xl">
		<span class="text-xs font-semibold tracking-[0.18em] opacity-70">{selectedWorkTeaser.label}</span>

		<h2 class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">{selectedWorkTeaser.heading}</h2>

		<div class="mt-10 grid gap-4 sm:grid-cols-2">
			{
				activeItems.map((item) => (
					<div class="flex flex-col justify-between rounded-2xl border border-neutral-200 bg-white/30 p-6 backdrop-blur-lg dark:border-[#49618b52] dark:bg-[linear-gradient(145deg,#101d35d1,#081020e0)] dark:shadow-[inset_0_1px_#ffffff06,0_20px_60px_#00000029]">
						<div>
							{item.logo && (
								<div class="mb-3 flex h-10 w-fit items-center rounded-lg bg-white px-3 py-2">
									<img
										src={item.logo}
										alt={item.title}
										width={item.logoWidth}
										height={item.logoHeight}
										loading="lazy"
										class="h-full w-auto object-contain"
									/>
								</div>
							)}
							{item.icon && (
								<div class="mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-white">
									{(() => {
										const Icon = icons[item.icon];
										return <Icon color="#FF0000" />;
									})()}
								</div>
							)}
							<p class="text-sm font-semibold">{item.title}</p>
							<p class="mt-2 text-xs text-neutral-500 dark:text-neutral-400">{item.description}</p>

							<div class="mt-4 flex flex-wrap gap-2">
								{item.tags
									.filter((tag) => tag.active)
									.map((tag) => (
										<span class="rounded-full border border-neutral-200 px-3 py-1 text-xs font-medium text-neutral-600 dark:border-neutral-700 dark:text-neutral-300">
											{tag.label}
										</span>
									))}
							</div>
						</div>

						{item.href && (
							<a
								href={item.href}
								target={item.href.startsWith('http') ? '_blank' : undefined}
								rel={item.href.startsWith('http') ? 'noopener noreferrer' : undefined}
								class="mt-4 text-xs font-semibold underline-offset-4 hover:underline"
							>
								{item.linkLabel ?? 'Learn more'} →
							</a>
						)}
					</div>
				))
			}
		</div>
	</div>
</section>
