---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import { isPostVisible } from '@/content.config';
import { tags } from '@/data/tags';
import { writingDefaultImage } from '@/data/writing';
import { renderPortableText } from '@/lib/portableText';

export async function getStaticPaths() {
	const posts = await getCollection('blog', isPostVisible);

	return posts.map((post) => {
		const seriesParts = post.data.seriesInfo
			? posts
					.filter((p) => p.data.seriesInfo?.slug === post.data.seriesInfo?.slug)
					.sort((a, b) => a.data.seriesInfo!.part - b.data.seriesInfo!.part)
			: [];
		const seriesIds = new Set(seriesParts.map((p) => p.id));
		const relatedPosts = posts
			.filter((p) => p.id !== post.id && !seriesIds.has(p.id))
			.map((p) => ({
				post: p,
				sharedTags: p.data.tags.filter((tag) => post.data.tags.includes(tag)).length,
			}))
			.filter((entry) => entry.sharedTags > 0)
			.sort((a, b) => b.sharedTags - a.sharedTags || b.post.data.pubDate.valueOf() - a.post.data.pubDate.valueOf())
			.slice(0, 5)
			.map((entry) => entry.post);

		return {
			params: { slug: post.id },
			props: { post, seriesParts, relatedPosts },
		};
	});
}

const { post, seriesParts, relatedPosts } = Astro.props;
const bodyHtml = renderPortableText(post.data.body);
const seriesName = post.data.seriesInfo?.name;
const seriesSlug = post.data.seriesInfo?.slug;
const hasSeries = Boolean(post.data.seriesInfo);
const hasRelated = relatedPosts.length > 0;
const postTags = post.data.tags.map((key) => tags[key]).filter((tag) => tag.active);
---

<Layout
	title={post.data.title}
	description={post.data.description}
	image={post.data.thumbnail?.url ?? writingDefaultImage.url}
	type="article"
	pubDate={post.data.pubDate}>
	<div class="mx-auto grid max-w-5xl gap-10 px-6 py-16 lg:grid-cols-[1fr_300px]">
		<article>
			<div class="flex gap-4">
				<a href="/" class="card-meta font-semibold underline-offset-4 hover:underline">← Home</a>
				<a href="/writing" class="card-meta font-semibold underline-offset-4 hover:underline">All posts</a>
			</div>

			<div class="mt-6 flex items-center gap-2">
				<p class="card-meta text-neutral-500 dark:text-neutral-400">
					{
						post.data.pubDate.toLocaleDateString('en-US', {
							year: 'numeric',
							month: 'long',
							day: 'numeric',
						})
					}
				</p>
				{post.data.draft && <span class="draft-badge">Draft</span>}
			</div>
			<h1 class="section-heading">{post.data.title}</h1>

			{
				postTags.length > 0 && (
					<div class="mt-4 flex flex-wrap gap-2">
						{postTags.map((tag) => (
							<span
								class:list={[
									'card-meta rounded-full border border-neutral-200 px-3 py-1 font-medium text-neutral-600',
									'dark:border-neutral-700 dark:text-neutral-300',
								]}>
								{tag.label}
							</span>
						))}
					</div>
				)
			}

			{
				hasSeries && (
					<a
						href={`/writing/series/${seriesSlug}`}
						class:list={[
							'mt-4 flex w-fit items-center gap-1.5 rounded-full bg-sky-100 px-3 py-1.5 text-xs font-semibold',
							'text-sky-700 transition hover:underline active:scale-95 lg:hidden dark:bg-sky-500/15 dark:text-sky-300',
						]}>
						Part {post.data.seriesInfo?.part} of {seriesParts.length} in {seriesName} →
					</a>
				)
			}

			<div class="post-content mt-8" set:html={bodyHtml} />
		</article>

		{
			(hasSeries || hasRelated) && (
				<aside class="flex flex-col gap-6 lg:sticky lg:top-6 lg:self-start">
					{hasSeries && (
						<div class="card-surface rounded-2xl p-6">
							<p class="card-meta text-neutral-500 dark:text-neutral-400">Series</p>
							<a href={`/writing/series/${seriesSlug}`} class="card-title mt-1 block font-semibold hover:underline">
								{seriesName}
							</a>
							<ol class="mt-4 flex flex-col gap-3">
								{seriesParts.map((part) =>
									part.id === post.id ? (
										<li class="card-meta font-semibold text-neutral-800 dark:text-neutral-200">
											{part.data.seriesInfo?.part}. {part.data.title}
										</li>
									) : (
										<li>
											<a
												href={`/writing/${part.id}`}
												class="card-meta block text-neutral-500 hover:underline dark:text-neutral-400">
												{part.data.seriesInfo?.part}. {part.data.title}
											</a>
										</li>
									),
								)}
							</ol>
						</div>
					)}

					{hasRelated && (
						<div class="card-surface rounded-2xl p-6">
							<p class="card-title font-semibold">Related Writings</p>
							<div class="mt-4 flex flex-col gap-3">
								{relatedPosts.map((related) => (
									<a
										href={`/writing/${related.id}`}
										class="card-meta block text-neutral-500 hover:underline dark:text-neutral-400">
										{related.data.title}
									</a>
								))}
							</div>
						</div>
					)}
				</aside>
			)
		}
	</div>
</Layout>

<style>
	@reference '@/styles/global.css';

	.post-content :global(p) {
		margin-top: 1.25em;
		line-height: 1.75;
	}
	.post-content :global(h2) {
		@apply border-l-[3px] border-sky-500 pl-3;
		margin-top: 2em;
		font-size: 1.5rem;
		font-weight: 700;
	}
	.post-content :global(ul) {
		margin-top: 1.25em;
		padding-left: 1.5em;
		list-style: disc;
	}
	.post-content :global(ol) {
		margin-top: 1.25em;
		padding-left: 1.5em;
		list-style: decimal;
	}
	.post-content :global(li) {
		margin-top: 0.5em;
	}
	.post-content :global(a) {
		@apply text-sky-600 underline underline-offset-2 dark:text-sky-400;
	}
	.post-content :global(a:hover) {
		@apply text-sky-700 dark:text-sky-300;
	}
	.post-content :global(code) {
		@apply rounded bg-neutral-100 px-1.5 py-0.5 text-[0.9em] dark:bg-neutral-800;
	}
	.post-content :global(figure) {
		margin-top: 1.25em;
	}
	.post-content :global(figcaption) {
		@apply text-sm text-neutral-500 dark:text-neutral-400;
		margin-top: 0.5em;
		text-align: center;
	}
	.post-content :global(.youtube-embed) {
		position: relative;
		height: 0;
		margin-top: 1.25em;
		padding-bottom: 56.25%;
	}
	.post-content :global(.youtube-embed iframe) {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		border: 0;
	}
</style>
