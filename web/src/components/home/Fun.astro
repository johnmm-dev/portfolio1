---
import { funGallery } from '@/data/fun';

const cardClass = 'card-surface relative flex w-full items-center justify-center overflow-hidden rounded-2xl';

// Mobile aspect ratio for each item's box. Originally derived from the
// desktop grid cell shape (see the `.fun-item-N` rules below) at a uniform
// column:row unit ratio, then hand-tuned per item afterwards - so treat
// these as fixed, not re-derivable from a single formula.
const aspectByNumber: Record<number, string> = {
	1: 'aspect-[72/55]',
	2: 'aspect-[72/55]',
	3: 'aspect-[108/55]',
	4: 'aspect-[108/55]',
	5: 'aspect-[96/55]',
	6: 'aspect-[36/55]',
	7: 'aspect-[24/55]',
	8: 'aspect-[108/55]',
	9: 'aspect-[72/55]',
	10: 'aspect-[72/55]',
};

const activeItems = funGallery.items.filter((item) => item.active);
// On mobile/masonry, the heading renders above the grid as normal (the only
// real <h2> for this section). On the tall desktop grid, a second, purely
// presentational copy fills the space next to items 1-2 (see .fun-heading
// below) - toggled by the same breakpoint that switches the grid on. It's
// aria-hidden and non-heading markup so assistive tech and DOM-only tooling
// never see two headings with identical text.
type GalleryEntry = (typeof activeItems)[number] | 'heading';
const galleryEntries: GalleryEntry[] = [...activeItems.slice(0, 2), 'heading', ...activeItems.slice(2)];
---

<section id="fun" class="flex min-h-screen flex-col justify-center px-6 py-16">
	<div class="relative z-10 mx-auto w-full max-w-6xl">
		<div class="fun-heading-top mb-10">
			<span class="section-label">{funGallery.label}</span>
			<h2 class="section-heading">{funGallery.heading}</h2>
		</div>

		<div class="fun-grid columns-2 gap-4">
			{
				galleryEntries.map((entry) =>
					entry === 'heading' ? (
						<div class="fun-heading mb-4 flex-col items-center justify-center text-center" aria-hidden="true">
							<span class="section-label">{funGallery.label}</span>
							<p class="section-heading">{funGallery.heading}</p>
						</div>
					) : (
						<div
							class={`${cardClass} fun-item-${entry.number} ${aspectByNumber[entry.number]} fun-box mb-4 break-inside-avoid`}>
							{entry.type === 'video' && entry.video ? (
								<video
									class="fun-video h-full w-full object-cover"
									src={entry.video}
									poster={entry.image}
									aria-label={entry.caption}
									muted
									loop
									playsinline
									preload="none"
								/>
							) : entry.image ? (
								<img src={entry.image} alt={entry.caption} loading="lazy" class="h-full w-full object-cover" />
							) : (
								<span class="text-4xl font-bold text-neutral-300 dark:text-neutral-700">{entry.number}</span>
							)}

							{entry.type === 'video' && (
								<span class="fun-play-icon absolute inset-0 flex items-center justify-center">
									<span
										class:list={[
											'flex h-10 w-10 items-center justify-center rounded-full bg-black/50 text-base text-white',
											'backdrop-blur-sm',
										]}>
										▶
									</span>
								</span>
							)}
						</div>
					),
				)
			}
		</div>
	</div>
</section>

<style>
	/* Mobile only (default): the heading renders above the grid as normal
	   (.fun-heading-top), and every box keeps its own aspect ratio inside the
	   two masonry columns.
	   Tablet and up (md+): named CSS Grid, 11 cols x 15 rows, matching the
	   bento layout; the top heading hides and .fun-heading takes over
	   instead, filling the empty cell next to items 1-2. */
	.fun-heading {
		display: none;
	}

	.fun-grid {
		transform-origin: top center;
	}

	.fun-play-icon {
		transition: opacity 0.2s ease;
	}

	.fun-box.is-playing .fun-play-icon {
		opacity: 0;
	}

	@media (min-width: 768px) {
		.fun-heading-top {
			display: none;
		}
		.fun-grid {
			display: grid;
			grid-template-columns: repeat(11, minmax(0, 1fr));
			grid-template-rows: repeat(15, minmax(0, 1fr));
			height: 1200px;
			gap: 8px;
		}
		.fun-box {
			margin-bottom: 0;
			aspect-ratio: auto;
		}
		.fun-heading {
			display: flex;
			grid-column: 5 / 12;
			grid-row: 1 / 4;
		}
		.fun-item-1 {
			grid-column: 1 / 3;
			grid-row: 1 / 3;
		}
		.fun-item-2 {
			grid-column: 3 / 5;
			grid-row: 2 / 4;
		}
		.fun-item-3 {
			grid-column: 2 / 8;
			grid-row: 4 / 7;
		}
		.fun-item-4 {
			grid-column: 3 / 9;
			grid-row: 7 / 9;
		}
		.fun-item-5 {
			grid-column: 3 / 7;
			grid-row: 9 / 11;
		}
		.fun-item-6 {
			grid-column: 3 / 5;
			grid-row: 11 / 14;
		}
		.fun-item-10 {
			grid-column: 5 / 8;
			grid-row: 11 / 14;
		}
		.fun-item-7 {
			grid-column: 10 / 12;
			grid-row: 8 / 15;
		}
		.fun-item-8 {
			grid-column: 7 / 10;
			grid-row: 9 / 11;
		}
		.fun-item-9 {
			grid-column: 8 / 11;
			grid-row: 4 / 7;
		}
	}

	/* Landscape / short-height screens (e.g. iPad landscape, short laptops):
	   the grid's fixed 1200px height doesn't fit, so scale it down instead of
	   switching to masonry. Tiered by viewport height; bands are non-
	   overlapping so the result doesn't depend on rule order. */
	@media (min-width: 768px) and (min-height: 1100px) and (max-height: 1249px) {
		.fun-grid {
			transform: scale(0.9);
		}
	}
	@media (min-width: 768px) and (min-height: 1000px) and (max-height: 1099px) {
		.fun-grid {
			transform: scale(0.8);
		}
	}
	@media (min-width: 768px) and (min-height: 800px) and (max-height: 999px) {
		.fun-grid {
			transform: scale(0.7);
		}
	}
	@media (min-width: 768px) and (min-height: 700px) and (max-height: 799px) {
		.fun-grid {
			transform: scale(0.6);
		}
	}
	@media (min-width: 768px) and (max-height: 699px) {
		.fun-grid {
			transform: scale(0.5);
		}
	}
</style>

<script>
	const section = document.getElementById('fun');
	const videos = document.querySelectorAll<HTMLVideoElement>('.fun-video');
	const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (section && videos.length && !prefersReducedMotion) {
		for (const video of videos) {
			const box = video.closest('.fun-box');
			video.addEventListener('play', () => box?.classList.add('is-playing'));
			video.addEventListener('pause', () => box?.classList.remove('is-playing'));
		}

		const observer = new IntersectionObserver(
			([entry]) => {
				for (const video of videos) {
					if (entry.isIntersecting) {
						video.play().catch(() => {});
					} else {
						video.pause();
					}
				}
			},
			{ threshold: 0.3 },
		);
		observer.observe(section);
	}
</script>
