---
import YoutubeIcon from '../common/icons/YoutubeIcon.astro';
import { selectedWorkTeaser } from '../../data/selected-work';

const icons = {
	youtube: YoutubeIcon,
};

const activeItems = selectedWorkTeaser.items.filter((item) => item.active).sort((a, b) => a.order - b.order);
---

<section id="projects" class="flex min-h-screen flex-col justify-center px-6 py-16">
	<div class="relative z-10 mx-auto max-w-6xl">
		<span class="section-label">{selectedWorkTeaser.label}</span>

		<h2 class="section-heading">{selectedWorkTeaser.heading}</h2>

		<div class="mt-10 grid gap-4 sm:grid-cols-2">
			{
				activeItems.map((item) => (
					<div class="card-surface flex flex-col justify-between rounded-2xl p-6">
						<div>
							{item.logo && (
								<div class="mb-3 flex h-10 w-fit items-center rounded-lg bg-white px-3 py-2">
									<img
										src={item.logo}
										alt={item.title}
										width={item.logoWidth}
										height={item.logoHeight}
										loading="lazy"
										class="h-full w-auto object-contain"
									/>
								</div>
							)}
							{item.icon && (
								<div class="mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-white">
									{(() => {
										const Icon = icons[item.icon];
										return <Icon color="#FF0000" />;
									})()}
								</div>
							)}
							<p class="card-body font-semibold">{item.title}</p>
							<p class="card-meta mt-2 text-neutral-500 dark:text-neutral-400">{item.description}</p>

							<div class="mt-4 flex flex-wrap gap-2">
								{item.tags
									.filter((tag) => tag.active)
									.map((tag) => (
										<span
											class:list={[
												'card-meta rounded-full border border-neutral-200 px-3 py-1 font-medium text-neutral-600',
												'dark:border-neutral-700 dark:text-neutral-300',
											]}>
											{tag.label}
										</span>
									))}
							</div>
						</div>

						{item.href && (
							<a
								href={item.href}
								target={item.href.startsWith('http') ? '_blank' : undefined}
								rel={item.href.startsWith('http') ? 'noopener noreferrer' : undefined}
								class="card-meta mt-4 font-semibold underline-offset-4 hover:underline">
								{item.linkLabel ?? 'Learn more'} →
							</a>
						)}
					</div>
				))
			}
		</div>
	</div>
</section>
