---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import { writingDefaultImage } from '@/data/writing';

const seriesList = (await getCollection('series')).sort((a, b) => a.data.name.localeCompare(b.data.name));
---

<Layout
	title="Series — Adnan Sabbir"
	description="Multi-part writing series, grouped by topic."
	image={writingDefaultImage.url}>
	<section class="mx-auto max-w-3xl px-6 py-16">
		<div class="flex gap-4">
			<a href="/" class="card-meta font-semibold underline-offset-4 hover:underline">← Home</a>
			<a href="/writing" class="card-meta font-semibold underline-offset-4 hover:underline">All posts</a>
		</div>

		<span class="section-label mt-6 block">Series</span>
		<h1 class="section-heading">Multi-part writing, grouped by topic.</h1>

		<div class="mt-10 flex flex-col gap-4">
			{
				seriesList.length > 0 ? (
					seriesList.map((item) => (
						<a
							href={`/writing/series/${item.id}`}
							data-ga-event="series_click"
							data-ga-params={JSON.stringify({ series_name: item.data.name, source_page: 'series_index' })}
							class="card-surface flex gap-4 rounded-2xl p-4 sm:p-6">
							<img
								src={item.data.image.url}
								alt={item.data.image.alt}
								class="h-24 w-24 shrink-0 rounded-xl object-cover sm:h-28 sm:w-28"
								loading="lazy"
								decoding="async"
							/>
							<div class="min-w-0">
								<div class="flex flex-col items-start gap-1 sm:flex-row sm:items-center sm:gap-2">
									<p class="card-body font-semibold">{item.data.name}</p>
									<span
										class:list={[
											'card-meta shrink-0 rounded-full border px-2.5 py-0.5 font-medium',
											item.data.status === 'completed'
												? 'border-emerald-200 text-emerald-700 dark:border-emerald-500/30 dark:text-emerald-300'
												: 'border-neutral-200 text-neutral-600 dark:border-neutral-700 dark:text-neutral-300',
										]}>
										{item.data.status === 'completed' ? 'Completed' : 'In Progress'}
									</span>
								</div>
								<p class="card-meta mt-2 text-neutral-500 dark:text-neutral-400">{item.data.description}</p>
							</div>
						</a>
					))
				) : (
					<p class="card-meta text-neutral-500 dark:text-neutral-400">No series published yet.</p>
				)
			}
		</div>
	</section>
</Layout>
