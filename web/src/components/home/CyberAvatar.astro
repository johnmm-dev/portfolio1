<style>
	#halo-left,
	#halo-right {
		animation: halo-beat 0.6s ease-in-out infinite;
	}
	#halo-right {
		animation-delay: 0.3s;
	}
	@keyframes halo-beat {
		0%,
		100% {
			stroke-width: 9;
			opacity: 1;
		}
		50% {
			stroke-width: 15;
			opacity: 0.75;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		#halo-left,
		#halo-right {
			animation: none;
		}
	}
</style>

<script>
	const avatar = document.getElementById('avatar-svg');
	const gaze = document.getElementById('gaze');
	const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (avatar && gaze && !prefersReducedMotion) {
		let targetX = 0;
		let targetY = 0;
		let currentX = 0;
		let currentY = 0;

		const handlePointerMove = (event: PointerEvent) => {
			const rect = avatar.getBoundingClientRect();
			const centerX = rect.left + rect.width / 2;
			const centerY = rect.top + rect.height / 2;
			const dx = event.clientX - centerX;
			const dy = event.clientY - centerY;
			const distance = Math.hypot(dx, dy) || 1;

			// Gaze movement eases toward the edge of the visor rather than jumping to it.
			// Range is limited to what still stays inside the visor's inner boundary.
			const strength = Math.min(distance / rect.width, 1);
			targetX = (dx / distance) * 14 * strength;
			targetY = (dy / distance) * 10 * strength;
		};

		const resetGaze = () => {
			targetX = 0;
			targetY = 0;
		};

		const animate = () => {
			currentX += (targetX - currentX) * 0.14;
			currentY += (targetY - currentY) * 0.14;
			gaze.setAttribute('transform', `translate(${currentX.toFixed(2)} ${currentY.toFixed(2)})`);
			requestAnimationFrame(animate);
		};

		window.addEventListener('pointermove', handlePointerMove, { passive: true });
		document.addEventListener('mouseleave', resetGaze);
		requestAnimationFrame(animate);
	}
</script>
