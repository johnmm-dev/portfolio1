---
import Hero from '@/components/home/Hero.astro';
import Work from '@/components/home/Work.astro';
import Writing from '@/components/home/Writing.astro';
import Fun from '@/components/home/Fun.astro';
import Contact from '@/components/home/Contact.astro';
import FluidBackground from '@/components/home/FluidBackground.astro';
import SectionNav from '@/components/home/SectionNav.astro';
import Layout from '@/layouts/Layout.astro';
import { pageTitles, homeDescription } from '@/data/site';
import { funGallery } from '@/data/fun';

const hasFunItems = funGallery.items.some((item) => item.active);
---

<Layout title={pageTitles.home} description={homeDescription}>
	<FluidBackground />
	<SectionNav />
	<Hero />
	<Work />
	<Writing />
	{hasFunItems && <Fun />}
	<Contact />
</Layout>
