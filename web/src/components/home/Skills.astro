---
import { skillCategories, skillsTeaser } from '@/data/skills';

const activeCategories = skillCategories
	.filter((category) => category.active)
	.sort((a, b) => a.order - b.order)
	.map((category) => ({
		...category,
		skills: category.skills.filter((skill) => skill.active).sort((a, b) => a.order - b.order),
	}));
---

<section id="skills" class="flex min-h-screen flex-col justify-center px-6 py-16">
	<div class="relative z-10 mx-auto max-w-6xl">
		<span class="section-label">{skillsTeaser.label}</span>

		<h2 class="section-heading">{skillsTeaser.heading}</h2>

		<div class="mt-10 grid gap-4 lg:grid-cols-3">
			{
				activeCategories.map((category) => (
					<div class:list={['card-surface rounded-2xl p-6', category.order === 1 && 'lg:col-span-3']}>
						<p class="card-body font-semibold">{category.heading}</p>

						<div class:list={['mt-4 grid gap-4', category.order === 1 && 'sm:grid-cols-2 lg:grid-cols-3']}>
							{category.skills.map((skill) => (
								<div>
									<p class="card-body font-semibold">{skill.name}</p>
									<p class="card-meta mt-1 text-neutral-500 dark:text-neutral-400">{skill.proof}</p>
								</div>
							))}
						</div>
					</div>
				))
			}
		</div>
	</div>
</section>
