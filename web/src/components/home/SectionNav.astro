---
import HomeIcon from '@/components/common/icons/HomeIcon.astro';
import FolderIcon from '@/components/common/icons/FolderIcon.astro';
import StarIcon from '@/components/common/icons/StarIcon.astro';
import SendIcon from '@/components/common/icons/SendIcon.astro';
import PenIcon from '@/components/common/icons/PenIcon.astro';
import { hero, isNavItemVisible, writingNavItem } from '@/data/home';
import { SECTION_EVENT_NAMES } from '@/lib/analytics';
import { isSanityConfigured } from '@/lib/sanity';

const icons = {
	folder: FolderIcon,
	star: StarIcon,
	send: SendIcon,
	pen: PenIcon,
};

const activeItems = hero.navItems.filter(
	(item) => isNavItemVisible(item) && (item !== writingNavItem || isSanityConfigured),
);

const linkClass =
	'section-nav-link flex shrink-0 flex-col items-center gap-0.5 rounded-full px-3 py-1.5 text-[10px] font-medium text-neutral-500 transition active:scale-95 md:px-4 md:py-2 md:text-xs dark:text-neutral-400';
---

<nav
	id="section-nav"
	aria-label="Quick navigation"
	class="card-surface fixed inset-x-0 z-40 mx-auto w-fit max-w-[92vw] rounded-full px-2 py-2 md:px-3">
	<div id="section-nav-track" class="flex gap-1 overflow-x-auto md:gap-2">
		<a
			href="#hero"
			data-section-link="hero"
			data-ga-event="nav_click"
			data-ga-params={JSON.stringify({ target_section: 'hero' })}
			class={linkClass}>
			<HomeIcon color="#0EA5E9" />
			<span>Home</span>
		</a>
		{
			activeItems.map((item) => {
				const Icon = icons[item.icon];
				const section = item.href.replace('#', '');
				return (
					<a
						href={item.href}
						data-section-link={section}
						data-ga-event="nav_click"
						data-ga-params={JSON.stringify({ target_section: SECTION_EVENT_NAMES[section] ?? section })}
						class={linkClass}>
						<Icon color={item.color} />
						<span>{item.label}</span>
					</a>
				);
			})
		}
	</div>
</nav>

<style>
	#section-nav {
		bottom: calc(1rem + env(safe-area-inset-bottom));
	}
	@media (min-width: 768px) {
		#section-nav {
			bottom: calc(1.5rem + env(safe-area-inset-bottom));
		}
	}
	#section-nav-track {
		scrollbar-width: none;
		-ms-overflow-style: none;
	}
	#section-nav-track::-webkit-scrollbar {
		display: none;
	}
	.section-nav-link.is-active {
		color: #171717;
		background-color: #f5f5f5;
	}
	:global(.dark) .section-nav-link.is-active {
		color: #fff;
		background-color: #ffffff14;
	}
</style>

<script>
	const links = document.querySelectorAll('.section-nav-link');

	const sections = Array.from(links)
		.map((link) => {
			const id = link.getAttribute('data-section-link');
			return id ? document.getElementById(id) : null;
		})
		.filter((section): section is HTMLElement => section !== null);

	if (sections.length) {
		import('@/lib/analytics').then(({ trackEvent, SECTION_EVENT_NAMES }) => {
			const viewedSections = new Set<string>();

			const sectionObserver = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						const link = document.querySelector(`[data-section-link="${entry.target.id}"]`);
						link?.classList.toggle('is-active', entry.isIntersecting);

						const sectionName = SECTION_EVENT_NAMES[entry.target.id];
						if (entry.isIntersecting && sectionName && sectionName !== 'hero' && !viewedSections.has(sectionName)) {
							viewedSections.add(sectionName);
							trackEvent('section_view', { section: sectionName });
						}
					});
				},
				{ rootMargin: '-50% 0px -50% 0px' },
			);
			sections.forEach((section) => sectionObserver.observe(section));
		});
	}
</script>
