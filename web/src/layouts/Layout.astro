---
import '@/styles/global.css';
import ThemeToggle from '@/components/common/ThemeToggle.astro';
import ConsentBanner from '@/components/common/ConsentBanner.astro';
import { socialLinks } from '@/data/social';

interface Props {
	title: string;
	description: string;
	image?: string;
	type?: 'website' | 'article';
	pubDate?: Date;
	noindex?: boolean;
}

const { title, description, image = 'og-image.jpg', type = 'website', pubDate, noindex = false } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site);

const personSchema = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: 'Adnan Sabbir',
	jobTitle: 'Senior Software Engineer',
	worksFor: { '@type': 'Organization', name: 'Odoo' },
	url: Astro.site,
	sameAs: Object.values(socialLinks)
		.filter((link) => link.active)
		.map((link) => link.href),
};

const articleSchema =
	type === 'article' && pubDate
		? {
				'@context': 'https://schema.org',
				'@type': 'Article',
				headline: title,
				description,
				image: ogImageURL,
				datePublished: pubDate.toISOString(),
				author: { '@type': 'Person', name: 'Adnan Sabbir', url: Astro.site },
			}
		: null;
---

<!doctype html>
<html lang="en">
	<head>
		<script is:inline>
			const stored = localStorage.getItem('theme');
			const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
			const isDark = stored ? stored === 'dark' : prefersDark;
			document.documentElement.classList.toggle('dark', isDark);
		</script>
		<script is:inline>
			// Consent Mode default, set before gtag.js loads. ad_* stays denied permanently.
			// A stored "denied" doesn't need an age check here - expired or not, it still
			// means the default (denied) is correct; only "granted" ever upgrades it, and
			// analytics.ts's getStoredConsent() is the one place that actually expires it.
			window.dataLayer = window.dataLayer || [];
			function gtag() {
				window.dataLayer.push(arguments);
			}
			window.gtag = gtag;
			gtag('consent', 'default', {
				ad_storage: 'denied',
				ad_user_data: 'denied',
				ad_personalization: 'denied',
				analytics_storage: 'denied',
			});
			if (localStorage.getItem('ga-consent') === 'granted') {
				gtag('consent', 'update', { analytics_storage: 'granted' });
			}
		</script>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
		<link rel="icon" type="image/png" sizes="48x48" href={`${import.meta.env.BASE_URL}favicon-48x48.png`} />
		<link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}apple-touch-icon.png`} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		<link rel="canonical" href={canonicalURL} />

		<meta property="og:type" content={type} />
		<meta property="og:site_name" content="Adnan Sabbir" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={ogImageURL} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageURL} />

		<script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
		{articleSchema && <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />}
	</head>
	<body
		class:list={[
			'bg-white font-sans text-neutral-900 antialiased',
			'dark:bg-[radial-gradient(circle_at_82%_20%,#1446843d,#0000_30%),linear-gradient(145deg,#040711_0%,#071022_55%,#060914_100%)] dark:text-neutral-100',
		]}>
		<a
			href="#main-content"
			class:list={[
				'sr-only rounded-full bg-white px-4 py-2 text-sm font-semibold text-neutral-900',
				'focus:not-sr-only focus:fixed focus:top-6 focus:left-6 focus:z-50',
			]}>
			Skip to content
		</a>
		<ThemeToggle />
		<ConsentBanner />
		<main id="main-content">
			<slot />
		</main>
		<script>
			import { initGtagConfig, loadGtagScript, initClickTracking } from '@/lib/analytics';

			const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
			if (gaMeasurementId) {
				initGtagConfig(gaMeasurementId);
				initClickTracking();
				window.addEventListener('load', () => loadGtagScript(gaMeasurementId));
			}
		</script>
	</body>
</html>

<style>
	html,
	body {
		width: 100%;
		min-height: 100%;
	}
</style>
