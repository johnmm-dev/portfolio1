---
import UserIcon from './icons/UserIcon.astro';
import FolderIcon from './icons/FolderIcon.astro';
import TerminalIcon from './icons/TerminalIcon.astro';
import StarIcon from './icons/StarIcon.astro';
import SendIcon from './icons/SendIcon.astro';
import type { IconName } from '../../data/home';

const icons = {
	user: UserIcon,
	folder: FolderIcon,
	terminal: TerminalIcon,
	star: StarIcon,
	send: SendIcon,
};

interface Props {
	label: string;
	href: string;
	icon: IconName;
	color: string;
}

const { label, href, icon, color } = Astro.props;
const Icon = icons[icon];
---

<a
	href={href}
	class="flex w-full items-center gap-3 rounded-2xl border border-neutral-200 bg-white/30 px-4 py-4 backdrop-blur-lg transition active:scale-95 dark:border-neutral-700 dark:bg-neutral-800/30 sm:aspect-square sm:w-auto sm:flex-col sm:justify-center sm:gap-1 sm:px-0 sm:py-6"
>
	<Icon color={color} />
	<span class="text-base font-medium">{label}</span>
</a>
