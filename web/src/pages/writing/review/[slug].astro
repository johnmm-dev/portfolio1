---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import PostContent from '@/components/writing/PostContent.astro';
import { writingDefaultImage } from '@/data/writing';
import { renderPortableText } from '@/lib/portableText';

export async function getStaticPaths() {
	const posts = await getCollection('blog', (post) => post.data.draft && post.data.reviewReady);

	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

const { post } = Astro.props;
const bodyHtml = renderPortableText(post.data.body);
---

<Layout
	title={post.data.title}
	description={post.data.description}
	image={post.data.thumbnail?.url ?? writingDefaultImage.url}
	type="article"
	pubDate={post.data.pubDate}
	noindex
	noAnalytics>
	<div class="mx-auto max-w-3xl px-6 py-16">
		<article>
			<div
				class:list={[
					'card-meta rounded-lg border border-amber-300 bg-amber-50 px-4 py-3 font-medium text-amber-800',
					'dark:border-amber-500/30 dark:bg-amber-500/10 dark:text-amber-300',
				]}>
				This post is still in draft mode. It's shared here for review only, not published yet.
			</div>

			<h1 class="section-heading mt-6">{post.data.title}</h1>

			<PostContent bodyHtml={bodyHtml} />
		</article>
	</div>
</Layout>
