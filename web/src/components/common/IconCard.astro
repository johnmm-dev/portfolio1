---
import UserIcon from './icons/UserIcon.astro';
import FolderIcon from './icons/FolderIcon.astro';
import TerminalIcon from './icons/TerminalIcon.astro';
import StarIcon from './icons/StarIcon.astro';
import SendIcon from './icons/SendIcon.astro';
import type { NavItem } from '../../data/home';

const icons = {
	user: UserIcon,
	folder: FolderIcon,
	terminal: TerminalIcon,
	star: StarIcon,
	send: SendIcon,
};

type Props = Omit<NavItem, 'active'>;

const { label, href, icon, color } = Astro.props;
const Icon = icons[icon];
---

<a
	href={href}
	class="flex w-full items-center gap-3 rounded-2xl border border-neutral-200 bg-white/30 px-4 py-4 backdrop-blur-lg transition active:scale-95 sm:aspect-square sm:w-28 sm:flex-col sm:justify-center sm:gap-1 sm:px-0 sm:py-6 dark:border-[#49618b52] dark:bg-[linear-gradient(145deg,#101d35d1,#081020e0)] dark:shadow-[inset_0_1px_#ffffff06,0_20px_60px_#00000029]"
>
	<Icon color={color} />
	<span class="text-base font-medium">{label}</span>
</a>
