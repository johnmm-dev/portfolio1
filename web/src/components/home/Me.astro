---
import GithubIcon from '@/components/common/icons/GithubIcon.astro';
import LinkedinIcon from '@/components/common/icons/LinkedinIcon.astro';
import FacebookIcon from '@/components/common/icons/FacebookIcon.astro';
import InstagramIcon from '@/components/common/icons/InstagramIcon.astro';
import YoutubeIcon from '@/components/common/icons/YoutubeIcon.astro';
import { meTeaser } from '@/data/about';
import { connect, socialLinks } from '@/data/social';

const socialIcons = {
	github: GithubIcon,
	linkedin: LinkedinIcon,
	facebook: FacebookIcon,
	instagram: InstagramIcon,
	youtube: YoutubeIcon,
};

const activeSocialLinks = Object.values(socialLinks)
	.filter((link) => link.active)
	.sort((a, b) => a.order - b.order);
---

<section id="me" class="flex min-h-screen flex-col justify-center px-6 py-16">
	<div class="relative z-10 mx-auto max-w-6xl">
		<div
			class:list={[
				'pointer-events-none absolute -top-24 left-1/2 -z-10 h-72 w-72 -translate-x-1/2 rounded-full bg-blue-500/10 blur-3xl',
				'dark:bg-blue-500/20',
			]}>
		</div>

		<div class="grid gap-10 lg:grid-cols-2 lg:items-center lg:gap-16">
			<div class="flex flex-col gap-6 lg:order-2">
				<div>
					<span class="section-label">{meTeaser.label}</span>
					<h2 class="section-heading">{meTeaser.heading}</h2>
				</div>

				<div class="flex flex-col gap-4 text-neutral-600 dark:text-neutral-300">
					{meTeaser.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
				</div>

				<div class="flex flex-wrap gap-3">
					{
						meTeaser.ctas
							.filter((cta) => cta.active)
							.sort((a, b) => a.order - b.order)
							.map((cta, index) => (
								<a
									href={cta.href}
									target={cta.href.startsWith('http') ? '_blank' : undefined}
									rel={cta.href.startsWith('http') ? 'noopener noreferrer' : undefined}
									class={
										index === 0
											? 'rounded-full bg-neutral-900 px-5 py-2.5 text-sm font-semibold text-white transition active:scale-95 dark:bg-white dark:text-neutral-900'
											: 'rounded-full border border-neutral-300 px-5 py-2.5 text-sm font-semibold transition active:scale-95 dark:border-neutral-700'
									}>
									{cta.label}
								</a>
							))
					}
				</div>

				<div class="flex flex-wrap gap-2">
					{
						meTeaser.tags
							.filter((tag) => tag.active)
							.map((tag) => (
								<span
									class:list={[
										'rounded-full border border-neutral-200 px-3 py-1 text-xs font-medium text-neutral-600',
										'dark:border-neutral-700 dark:text-neutral-300',
									]}>
									{tag.label}
								</span>
							))
					}
				</div>

				<div>
					<p class="section-label">{connect.heading}</p>

					<div class="mt-3 flex gap-3">
						{
							activeSocialLinks.map((link) => {
								const Icon = socialIcons[link.icon];
								return (
									<a
										href={link.href}
										target="_blank"
										rel="noopener noreferrer"
										aria-label={link.label}
										class="card-surface flex h-11 w-11 items-center justify-center rounded-full transition active:scale-95">
										<Icon />
									</a>
								);
							})
						}
					</div>
				</div>
			</div>

			<div class="grid grid-cols-2 gap-4 lg:order-1">
				{
					meTeaser.stats
						.filter((stat) => stat.active)
						.map((stat) => (
							<div class="card-surface rounded-2xl p-5">
								<p class="card-title font-bold tracking-tight">{stat.value}</p>
								<p class="card-meta mt-1 text-neutral-500 dark:text-neutral-400">{stat.label}</p>
							</div>
						))
				}
			</div>
		</div>
	</div>
</section>
