---
import HomeIcon from '../common/icons/HomeIcon.astro';
import UserIcon from '../common/icons/UserIcon.astro';
import FolderIcon from '../common/icons/FolderIcon.astro';
import TerminalIcon from '../common/icons/TerminalIcon.astro';
import StarIcon from '../common/icons/StarIcon.astro';
import SendIcon from '../common/icons/SendIcon.astro';
import { hero } from '../../data/home';

const icons = {
	user: UserIcon,
	folder: FolderIcon,
	terminal: TerminalIcon,
	star: StarIcon,
	send: SendIcon,
};

const activeItems = hero.navItems.filter((item) => item.active);

const linkClass =
	'section-nav-link flex flex-col items-center gap-0.5 rounded-full px-3 py-1.5 text-[10px] font-medium text-neutral-500 transition active:scale-95 md:px-4 md:py-2 md:text-xs dark:text-neutral-400';
---

<nav
	id="section-nav"
	aria-label="Quick navigation"
	data-visible="false"
	class="fixed inset-x-0 bottom-4 z-40 mx-auto flex w-fit gap-1 rounded-full border border-neutral-200 bg-white/70 px-2 py-2 shadow-lg backdrop-blur-lg md:bottom-6 md:gap-2 md:px-3 dark:border-[#49618b52] dark:bg-[linear-gradient(145deg,#101d35d1,#081020e0)] dark:shadow-[inset_0_1px_#ffffff06,0_20px_60px_#00000029]">
	<a href="#hero" data-section-link="hero" class={linkClass}>
		<HomeIcon color="#0EA5E9" />
		<span>Home</span>
	</a>
	{
		activeItems.map((item) => {
			const Icon = icons[item.icon];
			return (
				<a href={item.href} data-section-link={item.href.replace('#', '')} class={linkClass}>
					<Icon color={item.color} />
					<span>{item.label}</span>
				</a>
			);
		})
	}
</nav>

<style>
	#section-nav {
		transform: translateY(200%);
		transition: transform 0.3s ease;
	}
	#section-nav[data-visible='true'] {
		transform: translateY(0);
	}
	.section-nav-link.is-active {
		color: #171717;
		background-color: #f5f5f5;
	}
	:global(.dark) .section-nav-link.is-active {
		color: #fff;
		background-color: #ffffff14;
	}
</style>

<script>
	const nav = document.getElementById('section-nav');
	const heroSection = document.getElementById('hero');
	const links = document.querySelectorAll('.section-nav-link');

	if (nav && heroSection) {
		const heroObserver = new IntersectionObserver(
			([entry]) => {
				nav.dataset.visible = entry.isIntersecting ? 'false' : 'true';
			},
			{ rootMargin: '-50% 0px -50% 0px' },
		);
		heroObserver.observe(heroSection);
	}

	const sections = Array.from(links)
		.map((link) => {
			const id = link.getAttribute('data-section-link');
			return id ? document.getElementById(id) : null;
		})
		.filter((section): section is HTMLElement => section !== null);

	if (sections.length) {
		const sectionObserver = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					const link = document.querySelector(`[data-section-link="${entry.target.id}"]`);
					link?.classList.toggle('is-active', entry.isIntersecting);
				});
			},
			{ rootMargin: '-50% 0px -50% 0px' },
		);
		sections.forEach((section) => sectionObserver.observe(section));
	}
</script>
