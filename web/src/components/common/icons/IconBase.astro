---
interface Props {
	color?: string;
	size?: number;
	class?: string;
}

const { color = 'currentColor', size = 22, class: className } = Astro.props;
---

<svg
	xmlns="http://www.w3.org/2000/svg"
	width={size}
	height={size}
	viewBox="0 0 24 24"
	fill="none"
	stroke={color}
	stroke-width="2"
	stroke-linecap="round"
	stroke-linejoin="round"
	class={className}>
	<slot />
</svg>
