---
import Layout from '@/layouts/Layout.astro';
---

<Layout title="Page Not Found — Adnan Sabbir" description="The page you're looking for doesn't exist.">
	<section class="mx-auto max-w-3xl px-6 py-24 text-center">
		<span class="section-label">404</span>
		<h1 class="section-heading">This page doesn't exist.</h1>
		<p class="card-body mt-4 text-neutral-600 dark:text-neutral-300">
			The link might be broken, or the page may have moved.
		</p>
		<div class="mt-8 flex justify-center gap-4">
			<a href="/" class="card-meta font-semibold underline-offset-4 hover:underline">← Home</a>
			<a href="/writing" class="card-meta font-semibold underline-offset-4 hover:underline">All posts</a>
		</div>
	</section>
</Layout>
